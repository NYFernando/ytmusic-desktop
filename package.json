{
  "name": "ytmusic-desktop",
  "version": "1.0.0",
  "description": "YouTube Music Desktop by Nethum Fernando",
  "author": "Nethum Fernando",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/local/ytmusic-desktop"
  },
  "build": {
    "appId": "com.nethum.ytmusic.desktop",
    "productName": "YouTube Music Desktop",
    "copyright": "Copyright © 2026 Nethum Fernando",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico",
      "legalTrademarks": "Nethum Fernando"
    },
    "compression": "maximum",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YouTube Music Desktop",
      "artifactName": "YouTube-Music-Desktop-Setup-1.0.0.exe",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeader": "public/installer-header.bmp",
      "installerHeaderIcon": "public/icon.ico",
      "installerSidebar": "public/installer-sidebar.bmp",
      "uninstallerSidebar": "public/installer-sidebar.bmp",
      "uninstallDisplayName": "YouTube Music Desktop by Nethum Fernando",
      "license": "LICENSE.txt",
      "differentialPackage": false
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ]
  }
}
